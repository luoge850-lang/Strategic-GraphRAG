# Copy to deployment/.env on the Linux host; never commit that file.
# Empty required values make docker compose config fail closed.
DEMO_DOMAIN=
BASIC_AUTH_USER=
# Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
# Put the bcrypt hash in single quotes so Compose treats $ characters literally.
BASIC_AUTH_HASH=
API_KEY=

# Canonical id and exact collection in the verified immutable candidate package.
GRAPHRAG_BUILD_ID=
GRAPH_VECTOR_COLLECTION=
CANDIDATE_HOST_DIR=

# Absolute host paths to the exact PDF bytes recorded by the candidate build.
PDF_2023_FILE=
PDF_2024_FILE=
PDF_2025_FILE=

# A dedicated candidate database, with no old data or extra labels/relations.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Readiness currently requires an available LLM even with synthesize=false.
# Set one supported provider, its model, and its credential.
LLM_PROVIDER=
LLM_MODEL=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=
GRAPH_ACTIVE_FILING=2025-10-K.pdf
