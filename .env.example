# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# LLM API Keys
# Groq (free tier, OpenAI-compatible): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Gemini (free tier, REST API): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# DeepSeek (paid, OpenAI-compatible): https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Default LLM provider: gemini | groq | deepseek | ollama
# Ollama runs locally (free, no key, no rate limits):
#   1. Install: https://ollama.com/download/windows
#   2. Pull model: ollama pull qwen2.5:7b
#   3. Set LLM_PROVIDER=ollama
LLM_PROVIDER=groq
