# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# LLM API Keys
# Groq (free tier, OpenAI-compatible): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Gemini (free tier, REST API): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# DeepSeek (paid, OpenAI-compatible): https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Default LLM provider: gemini | groq | deepseek | ollama
# Ollama runs locally (free, no key, no rate limits):
#   1. Install: https://ollama.com/download/windows
#   2. Pull model: ollama pull qwen2.5:7b
#   3. Set LLM_PROVIDER=ollama
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# Retrieval scope for the current single-PDF stabilization build
GRAPH_ACTIVE_FILING=2025-10-K.pdf
GRAPH_VECTOR_COLLECTION=nvidia_sec_filings_active

# Cross-provider fallback is opt-in; keep empty unless explicitly approved.
LLM_FALLBACK_PROVIDERS=

# API hardening
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
API_AUTH_ENABLED=false
API_KEY=replace_in_production
RATE_LIMIT_PER_MINUTE=60
